# Feedback form config — copy this to  /var/www/aquafox-ja/instance/feedback.env
# on the VPS (NOT committed to git), fill it in, then:
#   sudo systemctl restart aquafox-ja
#
# If this file is absent or a value is blank, the feedback form still works and
# still saves every submission to the database — you just won't get an email,
# and /admin/feedback stays hidden (404).

# --- Gmail that SENDS the notification -------------------------------------
# Requires 2-Step Verification on the Google account, then an "App Password":
#   https://myaccount.google.com/apppasswords  (pick "Mail", copy the 16 chars)
GMAIL_ADDRESS=tomo820@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Where the notification is delivered (default: same as GMAIL_ADDRESS)
FEEDBACK_TO=tomo820@gmail.com

# --- Private admin page ---------------------------------------------------
# Reads every submission at:  https://oldmac.policy-log.jp/admin/feedback?key=THIS
# Make it long and random. Wrong / missing key => 404.
ADMIN_KEY=replace-with-a-long-random-string
